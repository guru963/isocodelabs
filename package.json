{
  "name": "tna-tracker",
  "private": true,
  "description": "Garment order tracker: daily floor numbers, run-rate delay warnings and read-only buyer progress.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api"
  }
}
