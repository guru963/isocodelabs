{
  "name": "tna-tracker",
  "private": true,
  "description": "Garment order tracker: daily floor numbers, run-rate delay warnings and read-only buyer progress.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:vercel": "npm run build:vercel -w apps/api && npm run build -w apps/web",
    "test": "npm test --workspaces",
    "test:integration": "npm run test:integration -w apps/api",
    "typecheck": "npm run typecheck --workspaces"
  }
}
