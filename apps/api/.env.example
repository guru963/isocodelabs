# Your Postgres connection string, such as a hosted Neon database.
# For local Docker use: postgresql://tna:tna_local_dev@localhost:5433/tna
DATABASE_URL=""

# Signs session cookies. Use a long random value of at least 32 characters.
JWT_SECRET=""

# Pins "today" so the fixed sample dates stay meaningful. Leave empty in real use.
APP_TODAY="2026-11-06"

# Where uploaded photos and voice notes are stored.
UPLOAD_DIR="./uploads"

# API key from console.groq.com. Without a key, notes skip the AI and go straight to human review.
GROQ_API_KEY=""

# Optional. The Groq model that reads notes. Leave out to use the default, openai/gpt-oss-120b.
# AI_MODEL=""

# Optional. Saves repeat reads so screens need not wait on the database.
# For local Docker use: redis://localhost:6379
# A hosted Redis works too, usually with a rediss:// address. Without it, the app still works, just slower.
REDIS_URL=""

# Password given to every seeded demo user.
SEED_DEMO_PASSWORD=""
