# Your Postgres connection string, such as a hosted Neon database.
# For local Docker use: postgresql://tna:tna_local_dev@localhost:5433/tna
DATABASE_URL=""

# Signs session cookies. Use a long random value of at least 32 characters.
JWT_SECRET=""

# Pins "today" so the fixed sample dates stay meaningful. Leave empty in real use.
APP_TODAY="2026-11-06"

# Where uploaded photos and voice notes are stored.
UPLOAD_DIR="./uploads"

# API key from console.groq.com. Without a key, notes skip the AI and go straight to human review.
GROQ_API_KEY=""

# Optional. The Groq model that reads notes. Leave out to use the default, openai/gpt-oss-120b.
# AI_MODEL=""

# Optional. Saves repeat reads so screens need not wait on the database.
# For local Docker use: redis://localhost:6379
# A hosted Redis works too, usually with a rediss:// address. Without it, the app still works, just slower.
REDIS_URL=""

# Optional. India time for the evening reminder to supervisors, and for the next-morning
# reminder about a missed day, sent to both supervisors and merchandisers. Defaults: 17:30 and 10:00.
# REMINDER_TIME="17:30"
# ESCALATION_TIME="10:00"

# Only on Vercel, and set by Vercel itself when a Blob store is connected to the project, so
# photos and voice notes survive between requests. New connections set BLOB_STORE_ID and sign in
# with OIDC; older ones set BLOB_READ_WRITE_TOKEN. Locally, leave both empty and files go to UPLOAD_DIR.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Only on Vercel. At least 16 characters. A scheduler sends it to /api/tasks/run to run the
# reminders and AI retries that a long-running server does on timers. Empty turns that endpoint off.
CRON_SECRET=""

# Password given to every seeded demo user.
SEED_DEMO_PASSWORD=""
