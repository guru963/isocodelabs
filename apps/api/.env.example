# Matches docker-compose.yml, for local development only.
DATABASE_URL="postgresql://tna:tna_local_dev@localhost:5433/tna"

# Signs session cookies. Use a long random value of at least 32 characters.
JWT_SECRET=""

# Pins "today" so the fixed sample dates stay meaningful. Leave empty in real use.
APP_TODAY="2026-11-06"

# Where uploaded photos and voice notes are stored.
UPLOAD_DIR="./uploads"

# Without a key, notes skip the AI and go straight to human review.
ANTHROPIC_API_KEY=""

# Password given to every seeded demo user.
SEED_DEMO_PASSWORD=""
